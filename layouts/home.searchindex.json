{{- /* Build-time search index: title, section, url and plain text of
       every docs page. Emitted as /index.json via the searchindex
       output format configured in the theme's hugo.toml. */ -}}
{{- $pages := slice -}}
{{- range site.RegularPages -}}
  {{- $pages = $pages | append (dict
      "title" .Title
      "section" (.Section | humanize)
      "url" .RelPermalink
      "content" .Plain) -}}
{{- end -}}
{{ $pages | jsonify }}
